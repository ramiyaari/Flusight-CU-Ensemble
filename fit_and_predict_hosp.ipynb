    "if(use_nowcast):\n",
    "    model_suffix = model_suffix + \"_nowcast\"\n",
    "\n",
    "for k in list(darts_local_models.keys()):\n",
    "    darts_local_models[k + model_suffix] = darts_local_models.pop(k)\n",
    "\n",
    "print(darts_local_models.keys())"

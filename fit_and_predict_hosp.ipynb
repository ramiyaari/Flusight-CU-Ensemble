    "sir_eakf_model = sir_eakf_model +\"_start_\" + sir_eakf_start_date.strftime(\"%y%m%d\")  \n",
    "if(use_nowcast):\n",
    "    sir_eakf_model = sir_eakf_model + \"_nowcast\"\n",
    "print(sir_eakf_model)\n",
    "\n",
